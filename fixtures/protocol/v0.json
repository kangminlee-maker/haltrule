      },
      "expect": {
        "refused": true
      }
    },
    {
      "id": "line_huge_float_refused",
      "value": {
        "$number": "1e308"
      },
      "expect": {
        "refused": true
      }
    },
    {
      "id": "line_bigint_past_range_refused",
      "value": {
        "$bigint": "9007199254740992"
      },
      "expect": {
        "refused": true
      }
    },
    {
      "id": "line_undefined_refused",
