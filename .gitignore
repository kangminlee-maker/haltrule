# local-only notes and evidence that must not be published
*.local.md
notes.local/

# language toolchains
__pycache__/
*.py[cod]
.venv/
node_modules/
dist/
target/
*.local.patch

# built binaries a gate makes
.bin/
rust/target/
mutants.out*/

# what building a package leaves behind (scripts/packages.sh, docs/releasing.md)
build/
*.egg-info/
# npm takes the two of these from the package directory and nowhere else, so
# docs/releasing.md copies them into ts/ for the publish and removes them after
ts/README.md
ts/LICENSE

# macOS folder droppings
.DS_Store
.generated/
